{
  "name": "golemui-ink",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal widgets that render GolemUI form definitions through Ink.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mudscientist/golemui-ink.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude"
  },
  "dependencies": {
    "@golemui/gui-validators": "2.1.0-rc.0"
  },
  "peerDependencies": {
    "@golemui/core": "2.1.0-rc.0",
    "@golemui/gui-shared": "2.1.0-rc.0",
    "@golemui/react": "2.1.0-rc.0",
    "ink": "^7.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@golemui/core": "2.1.0-rc.0",
    "@golemui/gui-shared": "2.1.0-rc.0",
    "@golemui/react": "2.1.0-rc.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink": "7.1.1",
    "ink-testing-library": "4.0.0",
    "prettier": "3.6.2",
    "react": "19.2.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "7.3.5",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "4.1.11"
  }
}
